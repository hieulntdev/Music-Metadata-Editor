# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Local editor state and temporary files
.idea/
.vscode/
*.swp
*.swo
*~

# npm-installed dependencies and local cache/logs
node_modules/
.npm/
npm-debug.log*

# Python virtual environments, bytecode, and local tool caches
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environment and private key material. Sanitized templates stay visible.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# User-selected application output must never become source.
/output/
/outputs/
/downloads/

# Local logs and temporary/backup files
*.log
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.copy

# Local tests
/tests/